# Generate a new key: python -c "import secrets; print(secrets.token_hex(32))"
# Empty required values intentionally prevent startup until configured.
SECRET_KEY=
USER_1_USERNAME=
USER_1_PASSWORD=
# Optional second account (same access; there are no roles).
USER_2_USERNAME=
USER_2_PASSWORD=

# 0 selects the first local camera; alternatively use an authorized RTSP URL.
# Camera credentials belong only in your private .env.
RTSP_URL=0
# Optional comma-separated exact camera hostnames/IPs; empty permits any RTSP host.
RTSP_ALLOWED_HOSTS=
DB_PATH=./database/plates.db
MAX_UPLOAD_MB=100
# Set true only when serving over HTTPS; local HTTP needs false.
SESSION_COOKIE_SECURE=false
# Point this to the corresponding source of your running version when deploying.
SOURCE_URL=https://github.com/Arashkazemii/Persian-License-Plate-Recognition-System
